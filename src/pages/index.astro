---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HomeDemoStrip } from "@/components/demo-card";
import { FeaturedRail } from "@/components/featured-rail";
import { HomeFaq } from "@/components/home-faq";
import { HomeSponsors } from "@/components/sponsors";
import { HomeHero, HomeWhatIsJev } from "@/components/home-sections";
import { faqPageJsonLd, itemListJsonLd, demoVideoJsonLd, webPageJsonLd } from "@/components/json-ld";
import { staticPageDate } from "@/lib/content-dates";
import { homeFaq } from "@/data/faq";
import { getHomepageDemos } from "@/data/showcase-demos";
import { getAllItems } from "@/lib/items";
import { agentGuidePath } from "@/data/agent-guides";
import { homePageSeo } from "@/lib/seo";

const items = getAllItems();
const seo = homePageSeo();
const homepageDemos = getHomepageDemos();
const videoJsonLd = homepageDemos.map((d) => demoVideoJsonLd(d));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/"
  ogImagePath={seo.imagePath}
  remoteShowcaseVideos
  showSponsors={false}
  jsonLd={[
    webPageJsonLd({
      name: seo.title,
      description: seo.description,
      url: seo.canonical,
      dateModified: staticPageDate("/"),
    }),
    itemListJsonLd(items.slice(0, 100)),
    faqPageJsonLd(homeFaq),
    ...videoJsonLd,
  ]}
>
  <HomeHero client:load />
  <div class="mx-auto flex max-w-6xl flex-col gap-20 px-4 py-16 sm:px-6 sm:py-20">
    <HomeWhatIsJev />
    <div>
      <p class="mb-8 text-sm leading-relaxed text-muted-foreground">
        Setup guides:{" "}
        <a href={agentGuidePath("hermes")} class="font-medium text-primary hover:underline">Jev with Hermes Agent</a>
        {" and "}
        <a href={agentGuidePath("github-copilot-agent")} class="font-medium text-primary hover:underline">GitHub Copilot Agent Mode + Jev</a>.
      </p>
      <HomeDemoStrip client:visible demos={homepageDemos} />
    </div>
    <FeaturedRail client:load />
    <HomeSponsors client:visible />
    <HomeFaq client:load />
  </div>
</BaseLayout>
