---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HomeDemoStrip } from "@/components/demo-card";
import { FeaturedRail } from "@/components/featured-rail";
import { HomeFaq } from "@/components/home-faq";
import { HomeSponsors } from "@/components/sponsors";
import { HomeHero } from "@/components/home-sections";
import { faqPageJsonLd, itemListJsonLd, demoVideoJsonLd } from "@/components/json-ld";
import { homeFaq } from "@/data/faq";
import { getHomepageDemos } from "@/data/showcase-demos";
import { getAllItems } from "@/lib/items";
import { homePageSeo } from "@/lib/seo";

const items = getAllItems();
const seo = homePageSeo();
const homepageDemos = getHomepageDemos();
const videoJsonLd = homepageDemos.map((d) => demoVideoJsonLd(d));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/"
  ogImagePath={seo.imagePath}
  remoteShowcaseVideos
  jsonLd={[itemListJsonLd(items.slice(0, 100)), faqPageJsonLd(homeFaq), ...videoJsonLd]}
>
  <HomeHero client:load />
  <div class="mx-auto flex max-w-6xl flex-col gap-20 px-4 py-16 sm:px-6 sm:py-20">
    <HomeDemoStrip client:visible demos={homepageDemos} />
    <FeaturedRail client:load />
    <HomeSponsors client:visible />
    <HomeFaq client:load />
  </div>
</BaseLayout>
