---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ButtonLink } from "@/components/button-link";
import { HomeDemoStrip } from "@/components/demo-video-card";
import { FeaturedRail } from "@/components/featured-rail";
import { HomeFaq } from "@/components/home-faq";
import { HomeQuickJump } from "@/components/home-quick-jump";
import { HomeHero, HomeWhyJev } from "@/components/home-sections";
import { faqPageJsonLd, itemListJsonLd, demoVideoJsonLd } from "@/components/json-ld";
import { homeFaq } from "@/data/faq";
import { getHomepageDemos } from "@/data/showcase-demos";
import { getAllItems } from "@/lib/items";
import { homePageSeo } from "@/lib/seo";

const items = getAllItems();
const seo = homePageSeo();
const homepageDemos = getHomepageDemos();
const videoJsonLd = homepageDemos.map((d) => demoVideoJsonLd(d));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/"
  ogImagePath={seo.imagePath}
  jsonLd={[itemListJsonLd(items.slice(0, 100)), faqPageJsonLd(homeFaq), ...videoJsonLd]}
>
  <HomeHero client:load />
  <div class="mx-auto max-w-6xl space-y-20 px-4 py-16 sm:px-6 sm:py-20">
    <HomeDemoStrip client:visible demos={homepageDemos} />
    <HomeQuickJump client:load />
    <FeaturedRail client:load />
    <HomeWhyJev client:load />
    <HomeFaq client:load />
    <section class="relative overflow-hidden rounded-md border border-primary/25 bg-gradient-to-br from-primary/10 via-card to-card p-8 shadow-sm md:flex md:items-center md:justify-between md:gap-8 md:p-10">
      <div class="relative max-w-xl">
        <h2 class="font-heading text-xl font-semibold sm:text-2xl">Shipping with Jev?</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Send the repo or demo. We click the links. Star counts stay honest or they stay blank.</p>
      </div>
      <ButtonLink href="/submit" class="relative mt-6 shrink-0 md:mt-0">Add your project</ButtonLink>
    </section>
  </div>
</BaseLayout>
