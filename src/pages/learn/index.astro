---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ButtonLink } from "@/components/button-link";
import { breadcrumbJsonLd } from "@/components/json-ld";
import { learnGuideSlugs, learnGuides } from "@/data/learn-guides";
import { learnIndexPageSeo } from "@/lib/seo";
import { siteConfig } from "@/lib/site";

const seo = learnIndexPageSeo();

const topics = learnGuideSlugs.map((slug) => {
  const g = learnGuides[slug];
  return { href: `/learn/${slug}`, title: g.title, description: g.description };
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/learn"
  ogImagePath={seo.imagePath}
  jsonLd={breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Learn", path: "/learn" },
  ])}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="max-w-2xl">
      <h1 class="font-heading text-3xl font-semibold sm:text-4xl">Learn Jev</h1>
      <p class="mt-3 leading-relaxed text-muted-foreground">
        System One in plain English. Meet <strong class="text-foreground">Choice</strong>, <strong class="text-foreground">Score</strong>, and <strong class="text-foreground">Noul</strong>, then jump to gateway wiring, MCP patterns, and real directory examples.
      </p>
    </header>
    <section class="mt-10 grid gap-4 md:grid-cols-3">
      <div class="rounded-md border border-border/60 p-6">
        <h2 class="font-mono text-sm text-accent">choice</h2>
        <p class="mt-2 text-sm text-muted-foreground">Pick one label from a list. You get choice, probabilities, and confidence.</p>
      </div>
      <div class="rounded-md border border-border/60 p-6">
        <h2 class="font-mono text-sm text-accent">score</h2>
        <p class="mt-2 text-sm text-muted-foreground">Rate state on a rubric. You get score, probabilities, confidence.</p>
      </div>
      <div class="rounded-md border border-border/60 p-6">
        <h2 class="font-mono text-sm text-accent">noul</h2>
        <p class="mt-2 text-sm text-muted-foreground">Is this statement true? You get a noul value from 0 to 1.</p>
      </div>
    </section>
    <section class="mt-12 rounded-md border border-primary/30 bg-primary/5 p-6 sm:p-8">
      <h2 class="font-heading text-xl font-semibold">Jev with AI agents</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        Thick setup guides for Hermes, OpenClaw, Claude Code, Cowork, Codex, OpenCode, and Cursor: MCP wiring, official TypeSafe skills, env keys, and catalog links.
      </p>
      <div class="mt-4">
        <ButtonLink href="/guides/jev-with-ai-agents">Open agent guides hub</ButtonLink>
      </div>
    </section>
    <section class="mt-12">
      <h2 class="font-heading text-xl font-semibold">Guides</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {topics.map((t) => (
          <li>
            <a href={t.href} class="block rounded-md border border-border/60 p-5 transition-colors hover:border-primary/40 hover:bg-primary/5">
              <p class="font-medium">{t.title}</p>
              <p class="mt-1 text-sm text-muted-foreground">{t.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="mt-12 flex flex-wrap gap-3">
      <ButtonLink href={siteConfig.typesafe.docs} external>Official TypeSafe docs</ButtonLink>
      <ButtonLink href={siteConfig.typesafe.playground} variant="outline" external>Playground</ButtonLink>
      <ButtonLink href={siteConfig.vercelGateway} variant="outline" external>Vercel AI Gateway (Jev)</ButtonLink>
      <ButtonLink href="/#home-faq-heading" variant="ghost">FAQ on home</ButtonLink>
    </section>
  </div>
</BaseLayout>
