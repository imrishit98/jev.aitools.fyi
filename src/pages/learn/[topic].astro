---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ButtonLink } from "@/components/button-link";
import { breadcrumbJsonLd, learnArticleJsonLd } from "@/components/json-ld";
import { learnGuideSlugs, getLearnGuide } from "@/data/learn-guides";
import { ogImagePaths, pageSeo } from "@/lib/seo";
import { siteConfig } from "@/lib/site";

export function getStaticPaths() {
  return learnGuideSlugs.map((topic) => ({ params: { topic } }));
}

const { topic } = Astro.params;
const guide = getLearnGuide(topic!);
if (!guide) throw new Error(`Unknown topic ${topic}`);

const seo = pageSeo({
  title: guide.title,
  description: guide.description,
  path: `/learn/${topic}`,
  type: "article",
  imagePath: ogImagePaths.learnTopic(topic!),
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={`/learn/${topic}`}
  type="article"
  ogImagePath={seo.imagePath}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Learn", path: "/learn" },
      { name: guide.title, path: `/learn/${topic}` },
    ]),
    learnArticleJsonLd(guide),
  ]}
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
      <a href="/learn" class="hover:text-accent">Learn</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{guide.title}</span>
    </nav>
    <h1 class="mt-4 font-heading text-3xl font-semibold">{guide.title}</h1>
    <p class="mt-3 text-lg text-muted-foreground">{guide.description}</p>
    <aside class="mt-8 rounded-md border border-primary/25 bg-primary/5 p-5">
      <p class="text-[11px] font-medium uppercase tracking-widest text-primary">Definition</p>
      <p class="mt-2 text-base leading-relaxed text-foreground">{guide.definition}</p>
    </aside>
    <div class="mt-10 space-y-8">
      {guide.headings.map((section) => (
        <section>
          <h2 class="font-heading text-xl font-semibold text-foreground">{section.h}</h2>
          <p class="mt-2 leading-relaxed text-muted-foreground">{section.body}</p>
        </section>
      ))}
    </div>
    <div class="mt-12 flex flex-wrap gap-3">
      {guide.exploreHref && <ButtonLink href={guide.exploreHref}>Matching listings</ButtonLink>}
      <ButtonLink href="/explore" variant="outline">Full directory</ButtonLink>
      <ButtonLink href={siteConfig.vercelGateway} variant="ghost" external>Vercel AI Gateway docs</ButtonLink>
    </div>
    <p class="mt-10 text-sm text-muted-foreground">
      More context on <a href="/" class="text-accent hover:underline">{siteConfig.name}</a> and the <a href="/llms.txt" class="text-accent hover:underline">llms.txt</a> map for AI crawlers.
    </p>
  </div>
</BaseLayout>
