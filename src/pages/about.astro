---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { aboutPageSeo } from "@/lib/seo";
import { siteConfig } from "@/lib/site";

const seo = aboutPageSeo();
const { publisherContact } = siteConfig;
---

<BaseLayout title={seo.title} description={seo.description} path="/about">
  <div class="max-w-3xl page-shell">
    <h1 class="font-heading text-3xl font-semibold">About {siteConfig.hostnameBrand}</h1>
    <div class="mt-8 space-y-6 leading-relaxed text-muted-foreground">
      <p>
        <strong class="text-foreground">{siteConfig.hostnameBrand}</strong> hosts <strong class="text-foreground">{siteConfig.name}</strong>, the public index of the TypeSafe Jev ecosystem: SDKs, integrations, agent tooling, demos, games, benchmarks, and guides.
      </p>
      <p>
        Published by <a href={siteConfig.parentBrand.url} class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">{siteConfig.parentBrand.name}</a> ({publisherContact.legalName}) as part of the aitools.fyi family. Canonical URL: <a href={siteConfig.url} class="text-accent hover:underline">{siteConfig.url}</a>.
      </p>
      <h2 class="font-heading text-xl font-semibold text-foreground">What we optimize for</h2>
      <p>
        Builders should find a working link fast, see honest context on each listing, and know whether a project is official TypeSafe property or community-built. We favor short, scannable detail pages and stable URLs over long marketing copy.
      </p>
      <h2 class="font-heading text-xl font-semibold text-foreground">How listings are chosen</h2>
      <p>
        Listings are curated from public TypeSafe documentation, GitHub repositories, demos, and community projects. We show star counts only when they are public. We do not invent metrics, download numbers, or URLs. When a project changes, we update or remove the entry based on maintainer feedback and public sources.
      </p>
      <p><strong class="text-foreground">Disclaimer:</strong> We are not TypeSafe AI unless a listing is an official TypeSafe property (docs, SDKs, playground, and similar). Community projects belong to their authors.</p>
      <h2 class="font-heading text-xl font-semibold text-foreground">For software agents</h2>
      <p>
        Start at <a href="/developers" class="text-accent hover:underline">/developers</a> (OpenAPI, llms.txt, and discovery notes). With <code class="rounded bg-muted px-1 text-foreground">Accept: text/markdown</code>, the homepage returns a Markdown overview; missing paths return Markdown 404 notes with links to home, llms.txt, and the sitemap.
      </p>
      <p>
        For LLM crawlers: <a href="/llms.txt" class="text-accent hover:underline">/llms.txt</a>. Publisher metadata: <a href="/.well-known/jev-directory.json" class="text-accent hover:underline">/.well-known/jev-directory.json</a>.
      </p>
      <p>
        Questions or corrections: <a href="/contact" class="text-accent hover:underline">/contact</a>. Privacy: <a href="/privacy" class="text-accent hover:underline">/privacy</a>.
      </p>
      <p>Missing something good? <a href="/submit" class="text-accent hover:underline">Submit a listing</a> and open a structured GitHub issue.</p>
    </div>
  </div>
</BaseLayout>
