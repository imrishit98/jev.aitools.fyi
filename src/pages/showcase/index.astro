---
import { InterestingDemoStrip, ShowcaseDemoGrid } from "@/components/demo-card";
import { ShowcasePageShare } from "@/components/share-menu";
import { demoVideoJsonLd } from "@/components/json-ld";
import { getInterestingDemos, showcaseDemos } from "@/data/showcase-demos";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { showcasePageSeo } from "@/lib/seo";

const seo = showcasePageSeo();
const jsonLd = showcaseDemos.map((d) => demoVideoJsonLd(d));
const count = showcaseDemos.length;
const interestingDemos = getInterestingDemos();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/showcase"
  ogImagePath={seo.imagePath}
  remoteShowcaseVideos
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-primary">
        Showcase
      </p>
      <h1 class="mt-2 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
        {count} demos, zero cope
      </h1>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Real posts from builders using Jev on production problems. Tap a card for the full clip, then steal the SDK.
      </p>
      <ShowcasePageShare client:visible />
    </header>
    <div class="mt-12 space-y-12">
      {interestingDemos.length > 0 && (
        <InterestingDemoStrip client:visible demos={interestingDemos} />
      )}
      <ShowcaseDemoGrid client:visible demos={showcaseDemos} />
    </div>
  </div>
</BaseLayout>
