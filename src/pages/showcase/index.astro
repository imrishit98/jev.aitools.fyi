---
import { DemoVideoCard } from "@/components/demo-video-card";
import { demoVideoJsonLd } from "@/components/json-ld";
import { showcaseDemos } from "@/data/showcase-demos";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { showcasePageSeo } from "@/lib/seo";

const seo = showcasePageSeo();
const jsonLd = showcaseDemos.map((d) => demoVideoJsonLd(d));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/showcase"
  ogImagePath={seo.imagePath}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-primary">
        Showcase
      </p>
      <h1 class="mt-2 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
        Seven demos, zero cope
      </h1>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Real posts from builders using Jev on production problems. Each clip links back to the original thread. Steal the vibe, then steal the SDK.
      </p>
    </header>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        showcaseDemos.map((demo) => (
          <DemoVideoCard client:visible demo={demo} />
        ))
      }
    </div>
  </div>
</BaseLayout>
