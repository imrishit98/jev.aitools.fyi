---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ButtonLink } from "@/components/button-link";
import { breadcrumbJsonLd, faqPageJsonLd } from "@/components/json-ld";
import {
  agentGuideSlugs,
  agentGuides,
  agentGuidesHub,
  agentGuidePath,
} from "@/data/agent-guides";
import { agentGuidesHubSeo } from "@/lib/seo";
import { splitIntoParagraphs } from "@/lib/prose";
import { getItemBySlug } from "@/lib/items";
import { itemHasDetailPage } from "@/lib/content-policy";
import { hrefForListing } from "@/lib/item-paths";
import { ExternalLink } from "lucide-react";

const seo = agentGuidesHubSeo();
const introParagraphs = splitIntoParagraphs(agentGuidesHub.intro, 280);
const cards = agentGuideSlugs.map((slug) => agentGuides[slug]);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/guides/jev-with-ai-agents"
  type="article"
  ogImagePath={seo.imagePath}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Guides", path: "/guides" },
      { name: agentGuidesHub.title, path: "/guides/jev-with-ai-agents" },
    ]),
    faqPageJsonLd(agentGuidesHub.faq),
  ]}
>
  <div class="max-w-6xl page-shell-breadcrumb">
    <nav class="breadcrumb-trail" aria-label="Breadcrumb">
      <a href="/guides" class="hover:text-accent">Guides</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{agentGuidesHub.title}</span>
    </nav>
    <header class="max-w-3xl">
      <h1 class="font-heading text-3xl font-semibold sm:text-4xl">{agentGuidesHub.title}</h1>
      <p class="mt-3 text-lg text-muted-foreground">{agentGuidesHub.tagline}</p>
      <div class="mt-4 space-y-3 text-muted-foreground">
        {introParagraphs.map((para) => <p class="leading-relaxed">{para}</p>)}
      </div>
    </header>

    <section class="mt-12">
      <h2 class="font-heading text-xl font-semibold">Platform guides</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {cards.map((g) => (
          <li>
            <a
              href={agentGuidePath(g.slug)}
              class="flex h-full flex-col rounded-md border border-border/60 p-6 transition-colors hover:border-primary/40 hover:bg-primary/5"
            >
              <p class="font-heading text-lg font-medium text-foreground">{g.title}</p>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{g.tagline}</p>
              <span class="mt-4 text-sm font-medium text-primary">Read guide →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14 rounded-md border border-border bg-card p-6 sm:p-8">
      <h2 class="font-heading text-xl font-semibold text-foreground">Also works with</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Patterns we did not give a full page yet, but the directory tracks them.
      </p>
      <ul class="mt-6 space-y-4">
        {agentGuidesHub.alsoWorksWith.map((row) => {
          const item = row.slug ? getItemBySlug(row.slug) : undefined;
          const listingHref = item ? hrefForListing(item) : undefined;
          const listingExternal = item ? !itemHasDetailPage(item) : false;
          return (
            <li class="border-t border-border/60 pt-4 first:border-t-0 first:pt-0">
              <p class="font-medium text-foreground">
                {item && listingHref ? (
                  <a
                    href={listingHref}
                    class="inline-flex items-center gap-1 text-accent hover:underline"
                    {...(listingExternal
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {row.name}
                    {listingExternal && (
                      <ExternalLink className="size-3.5 shrink-0 opacity-80" aria-hidden />
                    )}
                  </a>
                ) : (
                  row.name
                )}
              </p>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{row.note}</p>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="mt-14 max-w-3xl" id="faq">
      <h2 class="font-heading text-xl font-semibold text-foreground">FAQ</h2>
      <dl class="mt-6 space-y-6">
        {agentGuidesHub.faq.map((entry) => (
          <div>
            <dt class="font-medium text-foreground">{entry.question}</dt>
            <dd class="mt-2 leading-relaxed text-muted-foreground">{entry.answer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="mt-12 flex flex-wrap gap-3">
      <ButtonLink href="/learn">System One primers</ButtonLink>
      <ButtonLink href="/explore?category=agents" variant="outline">Browse agent tooling</ButtonLink>
      <ButtonLink href="/developers" variant="ghost">Agent crawl map</ButtonLink>
    </div>
  </div>
</BaseLayout>
