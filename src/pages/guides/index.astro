---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ButtonLink } from "@/components/button-link";
import { breadcrumbJsonLd } from "@/components/json-ld";
import {
  agentGuideSlugs,
  agentGuides,
  agentGuidesHub,
  agentGuidePath,
} from "@/data/agent-guides";
import { getItemsWithDetailPages } from "@/lib/items";
import { getItemPath } from "@/lib/item-paths";
import { itemBelongsOnSegment } from "@/lib/item-paths";
import { guidesIndexPageSeo } from "@/lib/seo";
import { siteConfig } from "@/lib/site";

const seo = guidesIndexPageSeo();

const agentCards = agentGuideSlugs.map((slug) => agentGuides[slug]);

const communityGuides = getItemsWithDetailPages()
  .filter((item) => itemBelongsOnSegment(item, "guides"))
  .sort((a, b) => (b.updatedAt ?? "").localeCompare(a.updatedAt ?? "") || a.title.localeCompare(b.title));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/guides"
  ogImagePath={seo.imagePath}
  jsonLd={breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides" },
  ])}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="max-w-2xl">
      <h1 class="font-heading text-3xl font-semibold sm:text-4xl">Guides</h1>
      <p class="mt-3 leading-relaxed text-muted-foreground">
        Long-form help for wiring Jev into agents and browsing community write-ups indexed in the directory. Start with the agent integration hub, then open a platform guide or a curated listing page.
      </p>
    </header>

    <section class="mt-12 rounded-md border border-primary/30 bg-primary/5 p-6 sm:p-8">
      <h2 class="font-heading text-xl font-semibold text-foreground">{agentGuidesHub.title}</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        {agentGuidesHub.tagline}
      </p>
      <div class="mt-4">
        <ButtonLink href="/guides/jev-with-ai-agents">Open agent guides hub</ButtonLink>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {agentCards.map((g) => (
          <li>
            <a
              href={agentGuidePath(g.slug)}
              class="block rounded-md border border-border/60 bg-card/80 p-5 transition-colors hover:border-primary/40 hover:bg-card"
            >
              <p class="font-medium text-foreground">{g.title}</p>
              <p class="mt-1 text-sm text-muted-foreground">{g.tagline}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="font-heading text-xl font-semibold">Community guide listings</h2>
          <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
            Articles and awesome lists we host as directory detail pages. For System One primers, see
            <a href="/learn" class="text-primary hover:underline">Learn</a>.
          </p>
        </div>
        <a href="/categories/guides" class="text-sm font-medium text-primary hover:underline">All guide category →</a>
      </div>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {communityGuides.map((item) => (
          <li>
            <a
              href={getItemPath(item)}
              class="block rounded-md border border-border/60 p-5 transition-colors hover:border-primary/40 hover:bg-primary/5"
            >
              <p class="font-medium">{item.title}</p>
              <p class="mt-1 text-sm text-muted-foreground">{item.oneLiner}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12 flex flex-wrap gap-3">
      <ButtonLink href="/learn">Learn hub</ButtonLink>
      <ButtonLink href="/explore?category=guides" variant="outline">Explore guides</ButtonLink>
      <ButtonLink href={siteConfig.typesafe.docs} variant="ghost" external>TypeSafe docs</ButtonLink>
    </section>
  </div>
</BaseLayout>
