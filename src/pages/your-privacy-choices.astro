---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PrivacyChoicesPanel } from "@/components/privacy-choices-panel";
import { privacyChoicesPageSeo } from "@/lib/seo";
import {
  LEGAL_LAST_UPDATED_DISPLAY,
  LEGAL_LAST_UPDATED_ISO,
  privacyContactEmail,
} from "@/lib/legal";
import { webPageJsonLd } from "@/components/json-ld";

const seo = privacyChoicesPageSeo();
const contactEmail = privacyContactEmail();
const jsonLd = webPageJsonLd({
  name: "Your Privacy Choices",
  description: seo.description,
  url: seo.canonical,
  dateModified: LEGAL_LAST_UPDATED_ISO,
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/your-privacy-choices"
  showSponsors={false}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-heading text-3xl font-semibold">Your Privacy Choices</h1>
    <p class="mt-3 text-sm text-muted-foreground">Last updated: {LEGAL_LAST_UPDATED_DISPLAY}</p>
    <p class="mt-4 leading-relaxed text-muted-foreground">
      Southern East Inc. runs Jev.aitools.fyi. We don't sell your personal information and we don't share it for targeted advertising. This page explains how to exercise your privacy rights anyway, including Global Privacy Control.
    </p>
    <p class="mt-3 leading-relaxed text-muted-foreground">
      Full details are in our <a href="/privacy" class="text-accent hover:underline">Privacy Policy</a>.
    </p>
    <div class="mt-10">
      <PrivacyChoicesPanel client:load />
    </div>
    <p class="mt-10 text-sm text-muted-foreground">
      Questions: <a href={`mailto:${contactEmail}`} class="text-accent hover:underline">{contactEmail}</a>
    </p>
  </div>
</BaseLayout>
