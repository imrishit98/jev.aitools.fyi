---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AudienceSwitch } from "@/components/audience-switch";
import { ButtonLink } from "@/components/button-link";
import { forAgentsPageSeo } from "@/lib/seo";
import { siteConfig } from "@/lib/site";

const seo = forAgentsPageSeo();
---

<BaseLayout title={seo.title} description={seo.description} path="/for-agents">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Agent view</p>
      <AudienceSwitch variant="hero" client:load />
    </div>
    <noscript>
      <p class="mt-2 text-sm">
        <a href="/" class="font-medium text-primary hover:underline">I'm human</a>
        (return to the homepage)
      </p>
    </noscript>
    <h1 class="mt-3 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
      Crawl map for software agents
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
      This page is the fast path for bots and integrators. Fetch the machine-readable files below, or send
      <code class="rounded bg-muted px-1.5 py-0.5 text-sm text-foreground">Accept: text/markdown</code>
      to
      <code class="rounded bg-muted px-1.5 py-0.5 text-sm text-foreground">/</code>
      or
      <code class="rounded bg-muted px-1.5 py-0.5 text-sm text-foreground">/for-agents</code>
      for Markdown bodies. Human readers can switch back with the control above or open
      <a href="/" class="text-primary hover:underline">the homepage</a>.
    </p>

    <div class="mt-10 space-y-8 leading-relaxed text-muted-foreground">
      <section>
        <h2 class="font-heading text-xl font-semibold text-foreground">Recommended fetch order</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-5">
          <li>
            <a href="/llms.txt" class="text-primary hover:underline">/llms.txt</a>
            Site map, counts, and editorial notes for LLM crawlers
          </li>
          <li>
            <a href="/openapi.json" class="text-primary hover:underline">/openapi.json</a>
            OpenAPI 3.1 for discovery GET endpoints on this directory
          </li>
          <li>
            <a href="/search-index.json" class="text-primary hover:underline">/search-index.json</a>
            Listing index used by Explore search
          </li>
          <li>
            <a href="/sitemap.xml" class="text-primary hover:underline">/sitemap.xml</a>
            Indexable HTML routes
          </li>
          <li>
            <a href="/.well-known/jev-directory.json" class="text-primary hover:underline"
              >/.well-known/jev-directory.json</a
            >
            Publisher manifest with URL patterns
          </li>
        </ol>
      </section>

      <section>
        <h2 class="font-heading text-xl font-semibold text-foreground">Homepage negotiation</h2>
        <p class="mt-3">
          Browsers without Markdown in <code class="rounded bg-muted px-1.5 py-0.5 text-sm text-foreground">Accept</code>
          always receive static HTML at
          <code class="rounded bg-muted px-1.5 py-0.5 text-sm text-foreground">/</code>
          (HTTP 200). With Markdown preferred, <code class="rounded bg-muted px-1.5 py-0.5 text-sm text-foreground">GET /</code>
          returns a short overview. Add
          <code class="rounded bg-muted px-1.5 py-0.5 text-sm text-foreground">?view=agent</code>
          for this longer crawl map in Markdown only.
        </p>
        <p class="mt-3">
          Responses include
          <code class="rounded bg-muted px-1.5 py-0.5 text-sm text-foreground">Vary: Accept</code>.
          Unknown paths return HTTP 404; Markdown 404 bodies link home, llms.txt, and the sitemap.
        </p>
      </section>

      <section>
        <h2 class="font-heading text-xl font-semibold text-foreground">Human-readable docs</h2>
        <p class="mt-3">
          Longer prose for integrators lives on
          <a href="/developers" class="text-primary hover:underline">/developers</a>. That page is not the TypeSafe
          Jev inference API; use
          <a
            href={siteConfig.typesafe.api}
            class="text-primary hover:underline"
            target="_blank"
            rel="noopener noreferrer">TypeSafe API docs</a
          >
          for System One calls.
        </p>
      </section>
    </div>

    <div class="mt-12 flex flex-wrap gap-3">
      <ButtonLink href="/llms.txt">Read llms.txt</ButtonLink>
      <ButtonLink href="/openapi.json" variant="outline">Open OpenAPI</ButtonLink>
      <ButtonLink href="/" variant="outline">Human homepage</ButtonLink>
    </div>
  </div>
</BaseLayout>
