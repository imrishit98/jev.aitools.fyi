---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExploreApp from "@/components/explore-app";
import { breadcrumbJsonLd, itemListJsonLd } from "@/components/json-ld";
import { getAllItems, getDirectoryStats } from "@/lib/items";
import { explorePageSeo } from "@/lib/seo";
import { siteConfig } from "@/lib/site";

const stats = getDirectoryStats();
const seo = explorePageSeo();
const all = getAllItems();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path="/explore"
  ogImagePath={seo.imagePath}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Explore", path: "/explore" },
    ]),
    itemListJsonLd(all, {
      name: "Jev Directory explore results",
      url: `${siteConfig.url}/explore`,
    }),
  ]}
>
  <div class="max-w-6xl page-shell">
    <header class="mb-8 max-w-2xl sm:mb-10">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Search the index</p>
      <h1 class="mt-2 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">Explore Jev listings</h1>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Filter by category, MCP, demos, GitHub, and more. Same public ecosystem the community ships to, sorted the way builders actually browse.
      </p>
    </header>
    <ExploreApp client:load />
  </div>
</BaseLayout>
