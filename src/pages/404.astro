---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ButtonLink } from "@/components/button-link";
---

<BaseLayout
  title="Page not found"
  description="That URL is not in the Jev Directory. Head home, explore listings, or read the agent docs."
  path="/404"
  robots="noindex, follow"
  includeCanonical={false}
  showSponsors={false}
>
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-medium uppercase tracking-widest text-primary">404</p>
    <h1 class="mt-3 font-heading text-3xl font-semibold sm:text-4xl">We looked. It is not here.</h1>
    <p class="mt-4 text-muted-foreground">
      Agents asking for Markdown on missing paths get a structured note with links. Humans get this page.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <ButtonLink href="/">Home</ButtonLink>
      <ButtonLink href="/explore" variant="outline">Explore</ButtonLink>
      <ButtonLink href="/llms.txt" variant="outline">llms.txt</ButtonLink>
    </div>
  </div>
</BaseLayout>
