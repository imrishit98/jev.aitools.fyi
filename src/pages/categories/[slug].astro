---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ItemCard } from "@/components/item-card";
import { breadcrumbJsonLd, faqPageJsonLd, itemListJsonLd } from "@/components/json-ld";
import { getCategory } from "@/data/categories";
import { CATEGORY_SLUGS } from "@/data/types";
import { getCategoryEnrichment } from "@/lib/category-enrichment";
import { getItemBySlug, getItemsByCategory } from "@/lib/items";
import { getItemPath } from "@/lib/item-paths";
import { categoryPageSeo } from "@/lib/seo";
import { siteConfig } from "@/lib/site";

export function getStaticPaths() {
  return CATEGORY_SLUGS.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const cat = getCategory(slug!);
if (!cat) throw new Error(`Unknown category ${slug}`);

const enrichment = getCategoryEnrichment(cat.slug);
const items = getItemsByCategory(cat.slug);
const seo = categoryPageSeo(cat, {
  title: enrichment?.seoTitle,
  description: enrichment?.seoDescription,
});
const categoryUrl = `/categories/${slug}`;

const highlightItems = (enrichment?.highlights ?? [])
  .map((h) => {
    const item = getItemBySlug(h.slug);
    return item ? { item, blurb: h.blurb } : null;
  })
  .filter(Boolean);

const jsonLdExtra = enrichment?.faq?.length
  ? [faqPageJsonLd(enrichment.faq)]
  : [];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={categoryUrl}
  ogImagePath={seo.imagePath}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Explore", path: "/explore" },
      { name: cat.title, path: categoryUrl },
    ]),
    itemListJsonLd(items, {
      name: `${cat.title} · Jev Directory`,
      url: `${siteConfig.url}${categoryUrl}`,
    }),
    ...jsonLdExtra,
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav class="mb-6 text-sm text-muted-foreground" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
      <span class="mx-2">/</span>
      <a href="/explore" class="hover:text-accent">Explore</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{cat.title}</span>
    </nav>
    <header class="mb-10 max-w-3xl">
      <h1 class="font-heading text-3xl font-semibold sm:text-4xl">{cat.title}</h1>
      <p class="mt-3 text-muted-foreground">{cat.description}</p>
      {cat.intro && <p class="mt-4 text-base leading-relaxed text-foreground/85">{cat.intro}</p>}
      {
        enrichment && (
          <div class="mt-6 space-y-4 text-base leading-relaxed text-foreground/90">
            <p>
              <span class="font-medium text-foreground">Who it is for:</span> {enrichment.whoItsFor}
            </p>
            <p>
              <span class="font-medium text-foreground">How to choose:</span> {enrichment.howToChoose}
            </p>
          </div>
        )
      }
      <p class="mt-3 text-sm text-muted-foreground">
        {items.length} listings in this bucket · <a href="/learn" class="text-primary hover:underline">Learn Jev</a>
        {
          cat.slug === "benchmarks" && (
            <>
              {" "}
              · <a href="/benchmarks/rorshopping-jev-on-a-laptop" class="text-primary hover:underline">Laptop benchmark results</a>
            </>
          )
        }
      </p>
    </header>

    {
      enrichment && enrichment.sections.length > 0 && (
        <section class="mb-12 max-w-3xl space-y-8" aria-labelledby="category-guide-heading">
          <h2 id="category-guide-heading" class="font-heading text-2xl font-semibold">Guide</h2>
          {enrichment.sections.map((section) => (
            <div>
              <h3 class="font-heading text-lg font-semibold">{section.heading}</h3>
              <p class="mt-3 text-base leading-relaxed text-foreground/90">{section.body}</p>
            </div>
          ))}
        </section>
      )
    }

    {
      highlightItems.length > 0 && (
        <section class="mb-12" aria-labelledby="category-highlights-heading">
          <h2 id="category-highlights-heading" class="font-heading text-2xl font-semibold">Highlights</h2>
          <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
            Hand-picked listings with extra detail on this directory. Star counts and demos still live on each card.
          </p>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {highlightItems.map((entry) => (
              <li class="surface-card p-5">
                <a
                  href={getItemPath(entry!.item)}
                  class="font-medium text-primary hover:underline"
                >
                  {entry!.item.title}
                </a>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{entry!.blurb}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      enrichment?.faq && enrichment.faq.length > 0 && (
        <section class="mb-12 surface-card p-6 sm:p-8 max-w-3xl" aria-labelledby="category-faq-heading">
          <h2 id="category-faq-heading" class="font-heading text-2xl font-semibold">FAQ</h2>
          <dl class="mt-6 space-y-6">
            {enrichment.faq.map((entry) => (
              <div>
                <dt class="font-medium text-foreground">{entry.question}</dt>
                <dd class="mt-2 text-base leading-relaxed text-muted-foreground">{entry.answer}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <section aria-labelledby="category-listings-heading">
      <h2 id="category-listings-heading" class="mb-6 font-heading text-2xl font-semibold">All listings</h2>
      {
        items.length === 0 ? (
          <div class="surface-card rounded-md border-dashed px-6 py-12 text-center">
            <p class="font-heading text-lg">Nothing here yet</p>
            <p class="mt-2 text-sm text-muted-foreground">
              Be the first in this category. <a href="/submit" class="text-primary hover:underline">Submit a listing</a>.
            </p>
          </div>
        ) : (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((item) => (
              <ItemCard item={item} />
            ))}
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
