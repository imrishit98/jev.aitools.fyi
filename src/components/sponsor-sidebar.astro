---
import { sponsors, sponsorInitial } from "@/data/sponsors";
import { sponsorHref, sponsorLinkRel } from "@/lib/outbound-attribution";

const LOGO_SIZE = 22;
---

<section
  class="surface-card mt-4 hidden p-3 lg:block"
  aria-labelledby="page-sponsors-sidebar-heading"
>
  <p
    id="page-sponsors-sidebar-heading"
    class="mb-2 flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-foreground/90"
  >
    <span
      class="inline-block size-1.5 shrink-0 rounded-full bg-primary"
      aria-hidden="true"
    ></span>
    Sponsored
  </p>
  <ul class="space-y-1.5">
    {
      sponsors.map((sponsor) => (
        <li>
          <a
            href={sponsorHref(sponsor.url)}
            target="_blank"
            rel={sponsorLinkRel(sponsor.url)}
            class="flex w-full items-center gap-1.5 rounded-md border border-primary/20 bg-card/80 px-2 py-1 transition-colors hover:border-primary/35 hover:bg-card focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 focus-visible:ring-offset-background"
          >
            <span
              class="inline-flex size-5 shrink-0 items-center justify-center overflow-hidden rounded border border-border/70 bg-muted/50"
            >
              <img
                src={sponsor.logoUrl}
                alt={`${sponsor.name} logo`}
                width={LOGO_SIZE}
                height={LOGO_SIZE}
                class="size-full object-contain"
                loading="lazy"
                decoding="async"
                onerror="this.style.display='none';const f=this.nextElementSibling;if(f)f.style.display='flex'"
              />
              <span
                class="hidden size-full items-center justify-center font-heading text-[9px] font-semibold text-primary"
                aria-hidden="true"
              >
                {sponsorInitial(sponsor.name)}
              </span>
            </span>
            <span class="min-w-0 flex-1 truncate text-[13px] font-semibold leading-tight text-foreground">
              {sponsor.name}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
