---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Code2, ExternalLink, Megaphone } from "lucide-react";
import { ItemCard } from "@/components/item-card";
import { ItemBadges } from "@/components/item-badges";
import { CreatorCredit } from "@/components/creator-credit";
import { ButtonLink } from "@/components/button-link";
import { Badge } from "@/components/ui/badge";
import { ProductProfileDemos } from "@/components/demo-card";
import {
  breadcrumbJsonLd,
  faqPageJsonLd,
  listingJsonLd,
} from "@/components/json-ld";
import { getCategory } from "@/data/categories";
import { learnGuides } from "@/data/learn-guides";
import { getBenchmarkResults } from "@/data/benchmark-results";
import { getItemBySlug, getRelatedItemsForProduct } from "@/lib/items";
import { getItemPath } from "@/lib/item-paths";
import { getListingEnrichment } from "@/lib/listing-enrichment";
import {
  getDemosForProfile,
  getProductProfile,
  productProfileSeoDescription,
} from "@/lib/product-profiles";
import { itemListingSeo } from "@/lib/seo";
import { splitIntoParagraphs } from "@/lib/prose";
import { ItemListingShare } from "@/components/share-menu";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const item = getItemBySlug(slug);
if (!item) throw new Error(`Unknown item ${slug}`);

const profile = getProductProfile(slug);
const listingEnrichment = getListingEnrichment(slug);
const benchmarkResults = getBenchmarkResults(slug);
const cat = getCategory(item.category);
const related = getRelatedItemsForProduct(item);
const itemPath = getItemPath(item);
const seo = itemListingSeo(item);
const showcaseDemos = profile ? getDemosForProfile(profile) : [];
const relatedGuides = (profile?.relatedLearnSlugs ?? [])
  .map((guideSlug) => learnGuides[guideSlug])
  .filter(Boolean);

const descriptionParagraphs = splitIntoParagraphs(item.description);
const editorialParagraphs = item.editorialBlurb
  ? splitIntoParagraphs(item.editorialBlurb)
  : [];

const enrichmentFaq = [
  ...(listingEnrichment?.faq ?? []),
  ...(benchmarkResults?.faq ?? []),
];
const jsonLdExtra = [
  ...(profile?.faq?.length ? [faqPageJsonLd(profile.faq)] : []),
  ...(enrichmentFaq.length && !profile?.faq?.length
    ? [faqPageJsonLd(enrichmentFaq)]
    : []),
];
const listingDescription = profile
  ? productProfileSeoDescription(profile)
  : undefined;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={itemPath}
  type="article"
  ogImagePath={seo.imagePath}
  remoteShowcaseVideos={showcaseDemos.length > 0}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: cat?.title ?? item.category, path: `/categories/${item.category}` },
      { name: item.title, path: itemPath },
    ]),
    listingJsonLd(item, { description: listingDescription }),
    ...jsonLdExtra,
  ]}
>
  <article class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav class="mb-8 text-sm text-muted-foreground">
      <a href="/explore" class="hover:text-primary">Explore</a>
      <span class="mx-2 text-border">/</span>
      <a href={`/categories/${item.category}`} class="hover:text-primary">{cat?.title}</a>
      {profile && (
        <>
          <span class="mx-2 text-border">/</span>
          <a href="/explore?products=1" class="hover:text-primary">Products</a>
        </>
      )}
    </nav>
    <div class="grid gap-8 lg:grid-cols-[1fr_340px] lg:gap-10">
      <div class="space-y-8">
        <div class="surface-card p-6 sm:p-8 lg:p-10">
          <ItemBadges item={item} />
          {profile && (
            <Badge variant="secondary" className="mt-3 font-normal">Product profile</Badge>
          )}
          <div class="mt-4 flex flex-wrap gap-2">
            {item.language && <Badge variant="outline">{item.language}</Badge>}
            {typeof item.stars === "number" && item.stars > 0 && (
              <Badge variant="secondary">{item.stars.toLocaleString()} stars</Badge>
            )}
            {item.updatedAt && (
              <Badge variant="outline" className="font-normal text-muted-foreground">Updated {item.updatedAt}</Badge>
            )}
          </div>
          <h1 class="mt-5 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">{item.title}</h1>
          <p class="mt-3 text-lg leading-relaxed text-muted-foreground">{item.oneLiner}</p>
          <CreatorCredit item={item} className="mt-3" />
          {profile && (
            <div class="mt-6 flex flex-wrap gap-2">
              <ButtonLink href={item.url} external>
                <ExternalLink className="size-4" /> Open {profile.slug.includes("mcp") ? "setup" : "website"}
              </ButtonLink>
              {item.repoUrl && item.repoUrl !== item.url && (
                <ButtonLink href={item.repoUrl} variant="outline" external>
                  <Code2 className="size-4" /> Repository
                </ButtonLink>
              )}
              {item.demoUrl && (
                <ButtonLink href={item.demoUrl} variant="secondary" external>
                  <ExternalLink className="size-4" /> Live demo
                </ButtonLink>
              )}
              {showcaseDemos.length > 0 && (
                <ButtonLink href="/showcase" variant="outline">
                  Watch showcase clip
                </ButtonLink>
              )}
            </div>
          )}
        </div>

        {profile ? (
          <>
            <section class="surface-card p-6 sm:p-8" aria-labelledby="product-overview-heading">
              <h2 id="product-overview-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">Overview</h2>
              <p class="mt-4 text-base leading-relaxed text-foreground/90">{profile.overview}</p>
              <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                <span class="font-medium text-foreground">Problem:</span> {profile.problem}
              </p>
              <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                <span class="font-medium text-foreground">Built for:</span> {profile.targetUser}
              </p>
              {profile.firstSeen && (
                <p class="mt-4 text-sm text-muted-foreground">
                  <span class="font-medium text-foreground">First indexed on Jev Directory:</span> {profile.firstSeen}
                </p>
              )}
            </section>

            <section class="surface-card p-6 sm:p-8" aria-labelledby="product-creator-heading">
              <h2 id="product-creator-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">Creator and team</h2>
              <dl class="mt-4 space-y-3 text-base">
                <div>
                  <dt class="text-sm font-medium text-muted-foreground">Name</dt>
                  <dd class="mt-1 text-foreground">{profile.creator.name}</dd>
                </div>
                {profile.creator.company && (
                  <div>
                    <dt class="text-sm font-medium text-muted-foreground">Organization</dt>
                    <dd class="mt-1">
                      {profile.creator.companyUrl ? (
                        <a href={profile.creator.companyUrl} class="text-primary hover:underline" rel="noopener noreferrer" target="_blank">{profile.creator.company}</a>
                      ) : (
                        profile.creator.company
                      )}
                    </dd>
                  </div>
                )}
                {profile.creator.handle && (
                  <div>
                    <dt class="text-sm font-medium text-muted-foreground">Handle</dt>
                    <dd class="mt-1 text-foreground">@{profile.creator.handle}</dd>
                  </div>
                )}
                <div class="flex flex-wrap gap-3 pt-1">
                  {profile.creator.xUrl && (
                    <a href={profile.creator.xUrl} class="text-sm text-primary hover:underline" rel="noopener noreferrer" target="_blank">X profile</a>
                  )}
                  {profile.creator.githubUrl && (
                    <a href={profile.creator.githubUrl} class="text-sm text-primary hover:underline" rel="noopener noreferrer" target="_blank">GitHub</a>
                  )}
                </div>
              </dl>
              {profile.creatorQuote && (
                <blockquote class="mt-6 border-l-2 border-primary/40 pl-4 text-base italic leading-relaxed text-foreground/90">
                  &ldquo;{profile.creatorQuote.text}&rdquo;
                  <footer class="mt-2 text-sm not-italic text-muted-foreground">
                    {profile.creatorQuote.attributedTo},{" "}
                    <a href={profile.creatorQuote.sourceUrl} class="text-primary hover:underline" rel="noopener noreferrer" target="_blank">source</a>
                  </footer>
                </blockquote>
              )}
            </section>

            <section class="surface-card p-6 sm:p-8" aria-labelledby="product-jev-heading">
              <h2 id="product-jev-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">How Jev is used</h2>
              <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <div class="sm:col-span-2">
                  <dt class="text-sm font-medium text-muted-foreground">Role in the product flow</dt>
                  <dd class="mt-1 text-base leading-relaxed text-foreground/90">{profile.jevUsage.flowRole}</dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-muted-foreground">Primitives</dt>
                  <dd class="mt-2 flex flex-wrap gap-2">
                    {profile.jevUsage.primitives.map((p) => (
                      <Badge variant="secondary">{p}</Badge>
                    ))}
                  </dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-muted-foreground">State in</dt>
                  <dd class="mt-1 text-sm leading-relaxed text-foreground/90">{profile.jevUsage.stateIn}</dd>
                </div>
                <div class="sm:col-span-2">
                  <dt class="text-sm font-medium text-muted-foreground">Decision out</dt>
                  <dd class="mt-1 text-sm leading-relaxed text-foreground/90">{profile.jevUsage.decisionOut}</dd>
                </div>
              </dl>
              {profile.jevUsage.flowSteps && profile.jevUsage.flowSteps.length > 0 && (
                <ol class="mt-6 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-foreground/90">
                  {profile.jevUsage.flowSteps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
              )}
              <div class="mt-6 space-y-4 text-base leading-relaxed text-foreground/90">
                <p>{profile.howJevIsUsed}</p>
              </div>
              {profile.jevUsage.sourcedMetrics && profile.jevUsage.sourcedMetrics.length > 0 && (
                <div class="mt-6 rounded-md border border-border bg-muted/30 p-4">
                  <p class="text-sm font-medium text-foreground">Sourced performance claims</p>
                  <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
                    {profile.jevUsage.sourcedMetrics.map((m) => (
                      <li>
                        <span class="text-foreground">{m.claim}</span>
                        <span class="block text-xs text-muted-foreground">Source: {m.source}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>

            <section class="surface-card p-6 sm:p-8" aria-labelledby="product-features-heading">
              <h2 id="product-features-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">Features and stack</h2>
              <h3 class="mt-6 text-sm font-medium uppercase tracking-widest text-muted-foreground">Features</h3>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-base leading-relaxed text-foreground/90">
                {profile.keyFeatures.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <h3 class="mt-8 text-sm font-medium uppercase tracking-widest text-muted-foreground">Stack</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {profile.stack.map((tech) => (
                  <li>
                    <Badge variant="outline" className="font-normal">{tech}</Badge>
                  </li>
                ))}
              </ul>
              {profile.pricingNote && (
                <p class="mt-6 text-sm leading-relaxed text-muted-foreground">
                  <span class="font-medium text-foreground">Pricing:</span> {profile.pricingNote}
                </p>
              )}
            </section>

            {showcaseDemos.length > 0 && (
              <section class="surface-card p-6 sm:p-8" aria-labelledby="product-demo-heading">
                <h2 id="product-demo-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">Demo</h2>
                <p class="mt-2 text-sm text-muted-foreground">
                  Showcase clip with the same lightbox player as the homepage. Click to play.
                </p>
                <div class="mt-6">
                  <ProductProfileDemos client:visible demos={showcaseDemos} />
                </div>
              </section>
            )}

            <section class="surface-card p-6 sm:p-8" aria-labelledby="product-links-heading">
              <h2 id="product-links-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">Links</h2>
              <ul class="mt-4 space-y-2 text-base">
                {profile.links.website && (
                  <li><a href={profile.links.website} class="text-primary hover:underline" rel="noopener noreferrer" target="_blank">Website</a></li>
                )}
                {profile.links.repo && (
                  <li><a href={profile.links.repo} class="text-primary hover:underline" rel="noopener noreferrer" target="_blank">Repository</a></li>
                )}
                {profile.links.docs && (
                  <li><a href={profile.links.docs} class="text-primary hover:underline" rel="noopener noreferrer" target="_blank">Documentation</a></li>
                )}
                {profile.links.demo && (
                  <li><a href={profile.links.demo} class="text-primary hover:underline" rel="noopener noreferrer" target="_blank">Live demo</a></li>
                )}
                {profile.links.post && (
                  <li><a href={profile.links.post} class="text-primary hover:underline" rel="noopener noreferrer" target="_blank">Launch post</a></li>
                )}
              </ul>
            </section>

            {profile.faq && profile.faq.length > 0 && (
              <section class="surface-card p-6 sm:p-8" aria-labelledby="product-faq-heading">
                <h2 id="product-faq-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">FAQ</h2>
                <dl class="mt-4 space-y-6">
                  {profile.faq.map((entry) => (
                    <div>
                      <dt class="font-medium text-foreground">{entry.question}</dt>
                      <dd class="mt-2 text-base leading-relaxed text-muted-foreground">{entry.answer}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )}
          </>
        ) : (
          <div class="surface-card p-6 sm:p-8">
            <h2 class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">What it does</h2>
            <div class="mt-4 space-y-4 text-base leading-relaxed text-foreground/90">
              {descriptionParagraphs.map((para) => (
                <p>{para}</p>
              ))}
            </div>
            {editorialParagraphs.length > 0 && (
              <div class="mt-6 space-y-4 border-l-2 border-primary/30 pl-4 text-base leading-relaxed text-foreground/90">
                {editorialParagraphs.map((para) => (
                  <p>{para}</p>
                ))}
              </div>
            )}
          </div>
        )}

        {listingEnrichment && !profile && (
          <section class="surface-card p-6 sm:p-8" aria-labelledby="listing-jev-heading">
            <h2 id="listing-jev-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">How Jev is used</h2>
            {listingEnrichment.jevPrimitives && listingEnrichment.jevPrimitives.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {listingEnrichment.jevPrimitives.map((p) => (
                  <Badge variant="secondary">{p}</Badge>
                ))}
              </div>
            )}
            <p class="mt-4 text-base leading-relaxed text-foreground/90">{listingEnrichment.jevUsageSummary}</p>
            {listingEnrichment.setupNotes && (
              <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                <span class="font-medium text-foreground">Setup:</span> {listingEnrichment.setupNotes}
              </p>
            )}
            {listingEnrichment.caveats && (
              <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                <span class="font-medium text-foreground">Caveats:</span> {listingEnrichment.caveats}
              </p>
            )}
          </section>
        )}

        {listingEnrichment?.sections.map((section) => (
          <section class="surface-card p-6 sm:p-8" aria-labelledby={`listing-section-${section.heading}`}>
            <h2 id={`listing-section-${section.heading}`} class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">{section.heading}</h2>
            <div class="mt-4 space-y-4 text-base leading-relaxed text-foreground/90">
              {section.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </section>
        ))}

        {benchmarkResults && (
          <section class="surface-card p-6 sm:p-8" aria-labelledby="benchmark-results-heading">
            <h2 id="benchmark-results-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">Results</h2>
            <p class="mt-3 text-sm text-muted-foreground">
              Sourced from{" "}
              <a href={benchmarkResults.sourceUrl} class="text-primary hover:underline" rel="noopener noreferrer" target="_blank">
                {benchmarkResults.sourceUrl}
              </a>
              {" "}on {benchmarkResults.sourcedOn}. Numbers are copied as published; re-run upstream scripts to refresh.
            </p>
            <p class="mt-4 text-base leading-relaxed text-foreground/90">{benchmarkResults.summary}</p>
            {benchmarkResults.methodology && (
              <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
                <span class="font-medium text-foreground">Methodology:</span> {benchmarkResults.methodology}
              </p>
            )}
            <div class="mt-8 space-y-10">
              {benchmarkResults.tables.map((table) => (
                <div>
                  <h3 class="font-heading text-lg font-semibold">{table.title}</h3>
                  <div class="mt-4 overflow-x-auto rounded-md border border-border">
                    <table class="w-full min-w-[32rem] text-left text-sm">
                      <thead class="border-b border-border bg-muted/40">
                        <tr>
                          {table.columns.map((col) => (
                            <th class="px-3 py-2 font-medium text-foreground">{col}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {table.rows.map((row) => (
                          <tr class="border-b border-border/70 last:border-0">
                            {row.map((cell) => (
                              <td class="px-3 py-2 align-top text-muted-foreground">{cell}</td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {listingEnrichment?.faq && listingEnrichment.faq.length > 0 && !profile && (
          <section class="surface-card p-6 sm:p-8" aria-labelledby="listing-faq-heading">
            <h2 id="listing-faq-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">FAQ</h2>
            <dl class="mt-4 space-y-6">
              {listingEnrichment.faq.map((entry) => (
                <div>
                  <dt class="font-medium text-foreground">{entry.question}</dt>
                  <dd class="mt-2 text-base leading-relaxed text-muted-foreground">{entry.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {benchmarkResults?.faq && benchmarkResults.faq.length > 0 && (
          <section class="surface-card p-6 sm:p-8" aria-labelledby="benchmark-faq-heading">
            <h2 id="benchmark-faq-heading" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">Benchmark FAQ</h2>
            <dl class="mt-4 space-y-6">
              {benchmarkResults.faq.map((entry) => (
                <div>
                  <dt class="font-medium text-foreground">{entry.question}</dt>
                  <dd class="mt-2 text-base leading-relaxed text-muted-foreground">{entry.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {!profile && editorialParagraphs.length === 0 && descriptionParagraphs.length > 0 && (
          <span class="hidden" aria-hidden="true" />
        )}

        {profile && editorialParagraphs.length > 0 && (
          <div class="surface-card p-6 sm:p-8">
            <h2 class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">Directory notes</h2>
            <div class="mt-4 space-y-4 border-l-2 border-primary/30 pl-4 text-base leading-relaxed text-foreground/90">
              {editorialParagraphs.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>
        )}

        <div class="surface-card p-6 sm:p-8">
          <h2 class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">Tags</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <a href={`/explore?q=${encodeURIComponent(tag)}`} class="rounded-md border border-border bg-muted/50 px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:border-primary/30 hover:text-primary">#{tag}</a>
            ))}
          </div>
        </div>
      </div>
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="surface-card p-6">
          <p class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">Links</p>
          <div class="mt-4 flex flex-col gap-2">
            <ButtonLink href={item.url} className="w-full justify-start" external>
              <ExternalLink className="size-4" /> Open project
            </ButtonLink>
            {item.repoUrl && item.repoUrl !== item.url && (
              <ButtonLink href={item.repoUrl} variant="outline" className="w-full justify-start" external>
                <Code2 className="size-4" /> View repo
              </ButtonLink>
            )}
            {item.demoUrl && (
              <ButtonLink href={item.demoUrl} variant="secondary" className="w-full justify-start" external>
                <ExternalLink className="size-4" /> Open demo
              </ButtonLink>
            )}
            {item.postUrl && (
              <ButtonLink href={item.postUrl} variant="outline" className="w-full justify-start" external>
                <Megaphone className="size-4" /> Read launch post
              </ButtonLink>
            )}
          </div>
          <ItemListingShare
            client:visible
            title={item.title}
            oneLiner={item.oneLiner}
            path={itemPath}
          />
          <p class="mt-6 text-xs leading-relaxed text-muted-foreground">
            Stale link or wrong stars? <a href="/submit" class="text-primary hover:underline">Ping us on Submit</a>.
          </p>
        </div>
      </aside>
    </div>

    {relatedGuides.length > 0 && (
      <section class="mt-16 border-t border-border pt-14">
        <h2 class="font-heading text-2xl font-semibold">Related learn guides</h2>
        <p class="mt-1 text-sm text-muted-foreground">Original Jev guidance that pairs with this product pattern.</p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {relatedGuides.map((guide) => (
            <li class="surface-card p-5">
              <a href={`/learn/${guide.slug}`} class="font-medium text-primary hover:underline">{guide.title}</a>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{guide.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-16 border-t border-border pt-14">
        <h2 class="font-heading text-2xl font-semibold">Related products</h2>
        <p class="mt-1 text-sm text-muted-foreground">Hand-picked neighbors with rich profiles or overlapping tags.</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r) => (
            <ItemCard item={r} />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
