---
import { sponsors, sponsorInitial } from "@/data/sponsors";
import { sponsorHref, sponsorLinkRel } from "@/lib/outbound-attribution";

const LOGO_SIZE = 32;
---

<section
  class="border-b border-border/70 bg-gradient-to-b from-muted/50 via-muted/25 to-background"
  aria-labelledby="page-sponsors-heading"
>
  <div class="mx-auto max-w-6xl px-4 py-3 sm:px-6 sm:py-4 lg:py-5">
    <h2
      id="page-sponsors-heading"
      class="text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground"
    >
      Sponsored
    </h2>
    <ul class="mt-2.5 grid grid-cols-3 gap-2 sm:mt-3 sm:gap-3 lg:grid-cols-3 lg:gap-4">
      {
        sponsors.map((sponsor) => (
          <li class="min-w-0">
            <a
              href={sponsorHref(sponsor.url)}
              target="_blank"
              rel={sponsorLinkRel(sponsor.url)}
              class="group flex h-full min-h-[5.25rem] flex-col items-center rounded-md border border-border/90 bg-card/90 p-2 text-center shadow-sm transition-[border-color,box-shadow,background-color] hover:border-primary/30 hover:bg-card hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:min-h-[5.5rem] sm:p-2.5 lg:min-h-0 lg:flex-row lg:items-start lg:gap-3 lg:p-4 lg:text-left"
            >
              <span
                class="inline-flex size-7 shrink-0 items-center justify-center overflow-hidden rounded-md border border-border bg-muted/60 lg:size-9"
              >
                <img
                  src={sponsor.logoUrl}
                  alt={`${sponsor.name} logo`}
                  width={LOGO_SIZE}
                  height={LOGO_SIZE}
                  class="size-full object-contain"
                  loading="eager"
                  decoding="async"
                  onerror="this.style.display='none';const f=this.nextElementSibling;if(f)f.style.display='flex'"
                />
                <span
                  class="hidden size-full items-center justify-center font-heading text-[10px] font-semibold text-primary lg:text-xs"
                  aria-hidden="true"
                >
                  {sponsorInitial(sponsor.name)}
                </span>
              </span>
              <div class="mt-1.5 min-w-0 flex-1 lg:mt-0">
                <p
                  class="font-heading text-[11px] font-semibold leading-tight text-foreground sm:text-xs lg:text-base"
                >
                  {sponsor.name}
                </p>
                <p
                  class="mt-1 hidden line-clamp-2 text-sm leading-snug text-muted-foreground lg:block"
                >
                  {sponsor.tagline}
                </p>
                <p
                  class="mt-1 inline-flex items-center justify-center gap-0.5 text-[10px] font-medium text-primary group-hover:underline sm:text-[11px] lg:mt-2 lg:justify-start lg:text-sm"
                >
                  Visit
                  <svg
                    class="size-3 shrink-0 opacity-80 lg:size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M7 7h10v10" />
                  </svg>
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
