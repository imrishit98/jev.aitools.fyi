---
import { sponsors, sponsorInitial } from "@/data/sponsors";
import { sponsorHref, sponsorLinkRel } from "@/lib/outbound-attribution";

const LOGO_SIZE = 40;
---

<section
  class="border-b border-primary/20 bg-gradient-to-b from-primary/[0.08] via-primary/[0.04] to-background dark:from-primary/15 dark:via-primary/[0.06] dark:to-background"
  aria-labelledby="page-sponsors-heading"
  data-sponsor-featured
>
  <div class="mx-auto max-w-6xl px-4 py-3.5 sm:px-6 sm:py-5">
    <p
      id="page-sponsors-heading"
      class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-foreground sm:text-sm"
    >
      <span
        class="inline-block h-2 w-2 shrink-0 rounded-full bg-primary"
        aria-hidden="true"
      ></span>
      Sponsored
    </p>
    <ul
      class="mt-3 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] sm:mt-4 sm:grid sm:grid-cols-3 sm:gap-3 sm:overflow-visible sm:pb-0 sm:snap-none lg:gap-4 [&::-webkit-scrollbar]:hidden"
    >
      {
        sponsors.map((sponsor) => (
          <li
            class="w-[78%] max-w-[17rem] shrink-0 snap-start sm:w-auto sm:max-w-none"
          >
            <a
              href={sponsorHref(sponsor.url)}
              target="_blank"
              rel={sponsorLinkRel(sponsor.url)}
              class="group flex h-full flex-col rounded-lg border border-primary/30 bg-card/95 p-3 text-left shadow-sm ring-1 ring-primary/10 transition-[border-color,box-shadow,background-color] hover:border-primary/45 hover:bg-card hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:min-h-[7.5rem] sm:p-3.5 lg:flex-row lg:items-start lg:gap-3.5 lg:p-4"
            >
              <span
                class="inline-flex size-9 shrink-0 items-center justify-center overflow-hidden rounded-md border border-border/80 bg-muted/60 sm:size-10 lg:size-11"
              >
                <img
                  src={sponsor.logoUrl}
                  alt={`${sponsor.name} logo`}
                  width={LOGO_SIZE}
                  height={LOGO_SIZE}
                  class="size-full object-contain"
                  loading="eager"
                  decoding="async"
                  onerror="this.style.display='none';const f=this.nextElementSibling;if(f)f.style.display='flex'"
                />
                <span
                  class="hidden size-full items-center justify-center font-heading text-sm font-semibold text-primary"
                  aria-hidden="true"
                >
                  {sponsorInitial(sponsor.name)}
                </span>
              </span>
              <div class="mt-2.5 min-w-0 flex-1 sm:mt-3 lg:mt-0">
                <p
                  class="font-heading text-sm font-semibold leading-snug text-foreground sm:text-base"
                >
                  {sponsor.name}
                </p>
                <p
                  class="mt-1 hidden text-sm leading-snug text-muted-foreground sm:line-clamp-2"
                >
                  {sponsor.tagline}
                </p>
                <p
                  class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-primary group-hover:underline sm:text-sm"
                >
                  Visit site
                  <svg
                    class="size-3.5 shrink-0 opacity-90"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M7 7h10v10" />
                  </svg>
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
