---
import "../styles/global.css";
import { siteConfig } from "@/lib/site";
import { absoluteUrl, formatDocumentTitle, ogImagePaths, OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from "@/lib/seo";
import SiteHeader from "@/components/site-header";
import SiteFooter from "@/components/site-footer.astro";
import SiteCredit from "@/components/site-credit.astro";
import GlobalJsonLd from "@/components/global-json-ld.astro";

export interface Props {
  title: string;
  description: string;
  path: string;
  type?: "website" | "article";
  ogImagePath?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  path,
  type = "website",
  ogImagePath = ogImagePaths.default,
  jsonLd,
} = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(ogImagePath);
const fullTitle = formatDocumentTitle(title);
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Faculty+Glyphic&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Rishit Patel" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@imrishit98" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline define:vars={{ storageKey: "jev-directory-theme" }}>
      (function () {
        try {
          var stored = localStorage.getItem(storageKey) || "system";
          var dark =
            stored === "dark" ||
            (stored === "system" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.style.colorScheme = dark ? "dark" : "light";
        } catch (e) {}
      })();
    </script>
    <GlobalJsonLd />
    {
      jsonLd &&
        (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((block) => (
          <script
            type="application/ld+json"
            set:html={JSON.stringify(block)}
          />
        ))
    }
  </head>
  <body class="flex min-h-full flex-col font-sans">
    <SiteHeader client:load />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <SiteCredit />
  </body>
</html>
